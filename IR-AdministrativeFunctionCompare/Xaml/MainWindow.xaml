<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quest Security Management Platform"
        Height="915" Width="1920" WindowStartupLocation="CenterScreen" Background="#E9E9E9"
        MinHeight="800" MinWidth="1320" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TopBar" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="SideDark" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="SideSecondary" Color="#404040"/>
        <SolidColorBrush x:Key="QuestBlue" Color="#0078A8"/>
        <SolidColorBrush x:Key="ActiveBlue" Color="#0096D6"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="Foreground" Value="#0078A8"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TopBar}" BorderBrush="{StaticResource ActiveBlue}" BorderThickness="0,0,0,2">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="☰" Foreground="White" FontSize="20" Margin="0,0,16,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="16" Height="16" Fill="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Quest" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Width="1" Height="38" Background="#555" Margin="18,0"/>
                    <TextBlock Text="Security Management Platform" Foreground="White" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#3AAA35" Margin="0,0,8,0"/>
                    <TextBlock Text="All Systems Operational" Foreground="White" FontSize="13" Margin="0,0,18,0"/>
                    <TextBlock Text="✦" Foreground="#FF4BC1" FontSize="16" Margin="0,0,14,0"/>
                    <Grid Margin="0,0,10,0"><TextBlock Text="🔔" Foreground="White"/><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E53935" CornerRadius="8" MinWidth="14"><TextBlock Text="0" FontSize="9" Foreground="White" HorizontalAlignment="Center"/></Border></Grid>
                    <TextBlock Text="ⓘ" Foreground="White" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SideDark}">
                <StackPanel Margin="0,20,0,0">
                    <Border Background="#3C3C3C" Padding="4" Margin="8">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="↻" Foreground="White" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Recover" Foreground="White" FontSize="10"/></StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SideSecondary}">
                <Border Background="#3A3A3A" Margin="8" Padding="8"><TextBlock Text="Microsoft Entra ID" Foreground="White" FontSize="12" TextWrapping="Wrap"/></Border>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#D7D7D7" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Identity Recovery for Microsoft Entra ID" Foreground="#0078A8" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Contoso ▾" Foreground="#333" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderThickness="0" SelectedIndex="3">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#333333"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,2,4"/>
                                                <Border x:Name="ActiveUnderline" Height="3" Background="#0096D6" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ActiveUnderline" Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="#0078A8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="DASHBOARD"/>
                    <TabItem Header="BACKUPS"/>
                    <TabItem Header="UNPACKED OBJECTS"/>
                    <TabItem Header="DIFFERENCES"/>
                    <TabItem Header="EVENTS"/>
                    <TabItem Header="TASKS"/>
                </TabControl>

                <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="#CFCFCF" BorderThickness="0,1,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnLoadBackups" Content="MANAGE BACKUPS" Style="{StaticResource ActionButton}" Visibility="Collapsed"/>
                        <Button x:Name="BtnRefreshBackups" Content="MANAGE RESTORES" Style="{StaticResource ActionButton}" Visibility="Collapsed"/>
                        <Button x:Name="BtnCompare" Content="CREATE BACKUP" Style="{StaticResource ActionButton}" Visibility="Collapsed"/>
                        <Button x:Name="BtnBrowseSnapshot" Content="UNPACK BACKUP" Style="{StaticResource ActionButton}" Visibility="Collapsed"/>
                        <Button x:Name="BtnConnect" Content="CONFIGURE CONNECTION" Style="{StaticResource ActionButton}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="DifferencesView" Grid.Row="3" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Padding="20,14,20,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Content="List View" Height="30" Width="75" Background="#0078A8" Foreground="White" BorderBrush="#0078A8" FontSize="12"/>
                                <Button Content="Differences" Height="30" Width="90" Background="White" Foreground="#0078A8" BorderBrush="#0078A8" FontSize="12"/>
                                <TextBlock Text="Last Refresh 14 minutes ago" VerticalAlignment="Center" FontSize="12" Foreground="#333333" Margin="16,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="Tenant:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox Width="90" Height="28" SelectedIndex="0" FontSize="12" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Contoso"/></ComboBox>
                                <TextBlock Text="Backup:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox Width="90" Height="28" SelectedIndex="0" FontSize="12" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Latest unpacked backup"/><ComboBoxItem Content="Today at 12:00 PM"/><ComboBoxItem Content="Today at 6:00 AM"/><ComboBoxItem Content="Yesterday at 6:00 PM"/></ComboBox>
                                <TextBlock Text="Type:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox Width="90" Height="28" SelectedIndex="0" FontSize="12" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="User"/><ComboBoxItem Content="Group"/><ComboBoxItem Content="Service Principal"/><ComboBoxItem Content="Application"/><ComboBoxItem Content="Administrative Role"/><ComboBoxItem Content="Role Definition"/><ComboBoxItem Content="Role Assignment"/><ComboBoxItem Content="Policy"/></ComboBox>
                                <TextBlock Text="Change Type:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox Width="90" Height="28" SelectedIndex="0" FontSize="12" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Created"/><ComboBoxItem Content="Deleted"/><ComboBoxItem Content="Modified"/><ComboBoxItem Content="Hard Deleted"/><ComboBoxItem Content="Attribute Changed"/><ComboBoxItem Content="Assignment Added"/><ComboBoxItem Content="Assignment Removed"/><ComboBoxItem Content="Permission Added"/><ComboBoxItem Content="Permission Removed"/></ComboBox>
                                <TextBlock Text="Top 5 attributes:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox Width="90" Height="28" SelectedIndex="0" FontSize="12"><ComboBoxItem Content="Any"/><ComboBoxItem Content="displayName"/><ComboBoxItem Content="description"/><ComboBoxItem Content="rolePermissions"/><ComboBoxItem Content="allowedResourceActions"/><ComboBoxItem Content="principalId"/><ComboBoxItem Content="roleDefinitionId"/><ComboBoxItem Content="directoryScopeId"/></ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↺ RESTORE" Foreground="#B7B7B7" FontSize="12" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                <TextBlock Text="↗ EXPORT" Foreground="#B7B7B7" FontSize="12" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                <TextBlock Text="↻ REFRESH" Foreground="#0078A8" FontSize="12" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                <TextBlock Text="⚙ EDIT COLUMNS" Foreground="#0078A8" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="No objects" Foreground="#333333" FontSize="12" Margin="0,0,12,0"/>
                                <TextBox Width="190" Height="28" Text="Search" FontSize="12"/>
                                <Button Content="Search" Width="70" Height="28" Margin="8,0,0,0" Background="#0078A8" Foreground="White" BorderBrush="#0078A8" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderBrush="#D0D0D0" BorderThickness="1" HeadersVisibility="Column">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F2F2"/><Setter Property="Foreground" Value="#333333"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="34"/></Style>
                                <Style TargetType="DataGridRow"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#222222"/></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Width="42"/>
                                <DataGridTextColumn Header="" Width="42"/>
                                <DataGridTextColumn Header="Name" Width="260"/>
                                <DataGridTextColumn Header="Tenant" Width="110"/>
                                <DataGridTextColumn Header="Change" Width="180"/>
                                <DataGridTextColumn Header="Object Type" Width="210"/>
                                <DataGridTextColumn Header="Attribute" Width="160"/>
                                <DataGridTextColumn Header="Difference" Width="270"/>
                                <DataGridTextColumn Header="Backup" Width="260"/>
                                <DataGridTextColumn Header="Refresh" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1,0,1,1">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="No items to display" VerticalAlignment="Center" FontSize="12" Foreground="#333333"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Show" FontSize="12" Margin="0,0,6,0" Foreground="#333333"/>
                                    <ComboBox Width="58" Height="24" SelectedIndex="3"><ComboBoxItem Content="25"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="400"/></ComboBox>
                                    <TextBlock Text=" ⏮  ◀ " Foreground="#C0C0C0" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Text="0" Width="36" Height="24" BorderBrush="#CFCFCF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text=" / 0 " Foreground="#333333" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="▶  ⏭" Foreground="#C0C0C0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>


                <Border x:Name="ProcessingBanner" Grid.Row="3" Width="420" Height="54" Background="#43AD4B" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Visibility="Collapsed" Panel.ZIndex="20">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="13">
                            <Run x:Name="TxtProcessingBannerMessage" Text="Processing 1 object. "/><Run Text="View details" TextDecorations="Underline"/>
                        </TextBlock>
                        <Button x:Name="BtnCloseProcessingBanner" Grid.Column="1" Content="×" FontSize="18" Foreground="White" Background="Transparent" BorderThickness="0" Width="24" Height="24" VerticalAlignment="Center" Cursor="Hand"/>
                        <Button x:Name="BtnProcessingViewDetails" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>

                <Grid x:Name="UnpackedObjectsView" Grid.Row="3" Margin="12" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Padding="20,14,20,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Content="List View" IsChecked="True" Width="75" Height="30" Background="#0078A8" Foreground="White" BorderBrush="#0078A8" FontSize="12"/>
                            <ToggleButton Content="Objects" Width="70" Height="30" Margin="6,0,14,0" Background="White" Foreground="#0078A8" BorderBrush="#0078A8" FontSize="12"/>
                            <TextBlock Text="Backup:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="96" Height="28" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Latest unpacked backup"/><ComboBoxItem Content="Today at 12:00 PM"/></ComboBox>
                            <TextBlock Text="Type:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="96" Height="28" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="User"/><ComboBoxItem Content="Group"/><ComboBoxItem Content="Service Principal"/><ComboBoxItem Content="Role Definition"/><ComboBoxItem Content="Role Assignment"/></ComboBox>
                            <TextBlock Text="User Type:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="96" Height="28" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Member"/><ComboBoxItem Content="Guest"/></ComboBox>
                            <TextBlock Text="Microsoft Entra Connect:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="110" Height="28" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Cloud Only"/><ComboBoxItem Content="Synced"/></ComboBox>
                            <TextBlock Text="MFA:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="86" Height="28" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Enabled"/><ComboBoxItem Content="Disabled"/></ComboBox>
                            <TextBlock Text="Mail Enabled:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="86" Height="28" SelectedIndex="0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Enabled"/><ComboBoxItem Content="Disabled"/></ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↻ RESTORE" Foreground="#B7B7B7" FontSize="12" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                <TextBlock Text="↗ EXPORT" Foreground="#B7B7B7" FontSize="12" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                <TextBlock Text="⚙ EDIT COLUMNS" Foreground="#0078A8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TxtUnpackedCount" Text="337 objects" FontSize="12" Margin="0,0,12,0"/><TextBox Width="190" Height="28" Text="Search"/><Button Content="Search" Width="70" Height="28" Margin="8,0,0,0" Background="#0078A8" Foreground="White" BorderBrush="#0078A8"/></StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="GridUnpackedObjectsMain" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderBrush="#D0D0D0" BorderThickness="1" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding Selected}" Width="42"/>
                            <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="42"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="320"/>
                            <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="140"/>
                            <DataGridTextColumn Header="T..." Binding="{Binding Type}" Width="50"/>
                            <DataGridTextColumn Header="Backup Date" Binding="{Binding BackupDate}" Width="130"/>
                            <DataGridTextColumn Header="Mail" Binding="{Binding Mail}" Width="150"/>
                            <DataGridTextColumn Header="Microsoft Entra Connect" Binding="{Binding EntraConnect}" Width="200"/>
                            <DataGridTextColumn Header="MFA" Binding="{Binding MFA}" Width="80"/>
                            <DataGridTextColumn Header="City" Binding="{Binding City}" Width="75"/>
                            <DataGridTextColumn Header="Depa..." Binding="{Binding Department}" Width="80"/>
                            <DataGridTextColumn Header="Job T..." Binding="{Binding JobTitle}" Width="80"/>
                            <DataGridTextColumn Header="Desc..." Binding="{Binding Description}" Width="80"/>
                            <DataGridTextColumn Header="User ..." Binding="{Binding UserType}" Width="80"/>
                            <DataGridTextColumn Header="Mail Enabled" Binding="{Binding MailEnabled}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="TasksView" Grid.Row="3" Margin="12" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Padding="20,14,20,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="88" Height="28" SelectedIndex="0" Margin="0,0,14,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Queued"/><ComboBoxItem Content="Running"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Failed"/><ComboBoxItem Content="Cancelled"/></ComboBox>
                            <TextBlock Text="Type:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="88" Height="28" SelectedIndex="0" Margin="0,0,14,0"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Backup"/><ComboBoxItem Content="Unpacking"/><ComboBoxItem Content="Differences"/><ComboBoxItem Content="Restore"/><ComboBoxItem Content="Validation"/></ComboBox>
                            <Border x:Name="TaskNameFilterChip" Background="#0078A8" CornerRadius="14" Height="24" Padding="10,3" VerticalAlignment="Center" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="Task name: Unpack backups" Foreground="White" FontSize="12"/><TextBlock Text="  ×" Foreground="White" FontSize="12"/></StackPanel></Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⚙ EDIT COLUMNS" Foreground="#0078A8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TxtTasksCount" Text="0 task" FontSize="12" Margin="0,0,12,0"/><TextBox Width="190" Height="28" Text="Search"/><Button Content="Search" Width="70" Height="28" Margin="8,0,0,0" Background="#0078A8" Foreground="White" BorderBrush="#0078A8"/></StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="GridTasksMain" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderBrush="#D0D0D0" BorderThickness="1" HeadersVisibility="Column">
                        <DataGrid.Columns><DataGridTextColumn Header="" Binding="{Binding StatusIcon}" Width="45"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="260"/><DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="260"/><DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="260"/><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="280"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <ScrollViewer x:Name="DashboardView" Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <UniformGrid Columns="3" Margin="12">
                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="6" Padding="14"><StackPanel><TextBlock Text="Tenant is protected" FontSize="20"/><TextBlock Text="Name  Contoso" Foreground="#0078A8" Margin="0,8,0,0"/><TextBlock Text="Backup schedule  Enabled" Foreground="#0078A8"/><TextBlock Text="Retention  1825" Foreground="#0078A8"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="6" Padding="14"><StackPanel><TextBlock Text="143 backups" FontSize="20"/><Rectangle Height="120" Fill="#F1F5F9" Margin="0,10,0,10"/><TextBlock Text="SHOW ALL" Foreground="#0078A8"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="6" Padding="14"><StackPanel><TextBlock Text="51 tasks" FontSize="20"/><TextBlock Text="✔ Diff restore objects" Foreground="#76B900"/><TextBlock Text="✔ Refresh Differences" Foreground="#76B900"/><TextBlock Text="✖ Diff restore objects" Foreground="#E53935"/><TextBlock Text="SHOW ALL" Foreground="#0078A8" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="6" Padding="14"><StackPanel><TextBlock Text="345 unpacked objects" FontSize="20"/><Ellipse Width="120" Height="120" Fill="#E9EEF6" HorizontalAlignment="Center" Margin="0,8"/><TextBlock Text="SHOW ALL" Foreground="#0078A8"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="6" Padding="14"><StackPanel><TextBlock Text="1 change" FontSize="20"/><TextBlock Text="Administrative role definition changed" Foreground="#0078A8" Margin="0,10,0,0"/><TextBlock Text="SHOW ALL" Foreground="#0078A8" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="6" Padding="14"><StackPanel><TextBlock Text="94 errors" FontSize="20"/><TextBlock Text="✖ Role assignment could not be restored" Foreground="#E53935"/><TextBlock Text="✖ Snapshot integrity validation failed" Foreground="#E53935"/><TextBlock Text="SHOW ALL" Foreground="#0078A8" Margin="0,8,0,0"/></StackPanel></Border>
                    </UniformGrid>
                </ScrollViewer>

                <Grid x:Name="BackupsView" Grid.Row="3" Margin="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="170"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="1.2*"/>
