                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="Configure backup" FontSize="26" Foreground="#333333"/>
                                    <Button x:Name="BtnCloseConfigureBackup" Content="×" FontSize="22" FontWeight="SemiBold" Foreground="#0078A8" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
