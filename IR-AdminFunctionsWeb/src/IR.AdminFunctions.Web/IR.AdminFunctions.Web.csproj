<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IR.AdminFunctions.Web</RootNamespace>
    <AssemblyName>IR.AdminFunctions.Web</AssemblyName>
    <UserSecretsId>ir-admin-functions-web</UserSecretsId>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.61.3" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>IR.AdminFunctions.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\IR-AdministrativeFunctionBackup\Scripts\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="Scripts\Backup\%(Filename)%(Extension)" />
    <Content Include="..\..\..\IR-AdministrativeFunctionCompare\Scripts\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="Scripts\Compare\%(Filename)%(Extension)" />
    <Content Include="..\..\..\IR-AdministrativeFunctionRestore\Scripts\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="Scripts\Restore\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
